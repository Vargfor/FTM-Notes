{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vargfor/FTM-Notes/schemas/ftm/v1/recipe.schema.json",
  "title": "FTM recipe v1",
  "type": "object",
  "properties": {
    "type": {
      "const": "recipe"
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinned": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean"
    },
    "color": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "servings": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "prepMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cookMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "totalMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ingredientGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ingredientGroup"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "notes": {
      "type": "string"
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceName": {
      "type": [
        "string",
        "null"
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "rating": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 5
    }
  },
  "additionalProperties": false,
  "required": [
    "type"
  ],
  "$defs": {
    "quantity": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "min"
          ]
        }
      ]
    },
    "ingredient": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "scalable": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "packageQuantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "packageUnit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ingredientGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "timerSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": [
        "sha256",
        "mimeType"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
